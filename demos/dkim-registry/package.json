{
  "name": "@zk-email/dkim-registry-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Web demo for the DKIM Registry on Paseo: check a domain's DKIM keys against the on-chain registry and register them with a prefunded testnet wallet.",
  "scripts": {
    "build": "esbuild public/app.ts --bundle --outfile=public/app.js --format=iife",
    "start": "ts-node server.ts",
    "dev": "yarn build && yarn start"
  },
  "dependencies": {
    "@zk-email/helpers": "workspace:*",
    "@zk-email/scripts": "workspace:*",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
