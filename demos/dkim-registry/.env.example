# Paseo Asset Hub RPC (default is fine)
RPC_URL=https://eth-rpc-testnet.polkadot.io

# Address of the demo-owned DKIMRegistry the demo writes to.
DKIM_REGISTRY=

# Private key of the prefunded demo wallet that OWNS the registry above.
# Throwaway testnet key only — it signs every registration. Never reuse on mainnet.
PRIVATE_KEY=

# Optional: port to listen on (Render sets this automatically).
PORT=3000
