{
  "name": "@zk-email/circom-contracts",
  "version": "1.0.0",
  "description": "Circom onchain verifier contracts for ZKEmail Blueprints",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "build:polka": "hardhat compile",
    "deploy": "forge script script/DeployDKIMRegistry.s.sol --broadcast --non-interactive --rpc-url rpc_url",
    "deploy:polka": "hardhat run hh-scripts/deploy-dkim-registry.ts --network polkadotHubTestnet",
    "verify": "bash script/verify-dkim-registry.sh"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@parity/hardhat-polkadot": "^0.2.7",
    "@parity/hardhat-polkadot-resolc": "^0.2.3",
    "@types/node": "^25.3.3",
    "dotenv": "^17.3.1",
    "ethers": "^6.14.0",
    "forge-std": "https://github.com/foundry-rs/forge-std",
    "hardhat": "^2.28.6",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
